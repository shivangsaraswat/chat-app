{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "npx esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:bcryptjs --external:fsevents --external:@prisma/client --external:prisma --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
        "start": "node dist/index.js",
        "start:dev": "tsx watch src/index.ts",
        "lint": "eslint src/",
        "clean": "rm -rf dist",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "render-build": "prisma generate && pnpm run build",
        "db:seed": "tsx ../infra/db/seed.ts"
    },
    "dependencies": {
        "@chat-app/config": "workspace:*",
        "@chat-app/types": "workspace:*",
        "@chat-app/utils": "workspace:*",
        "@prisma/client": "^5.8.0",
        "@types/multer": "^2.0.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "imagekit": "^5.0.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "nodemailer": "^6.9.7",
        "socket.io": "^4.6.1",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^22.0.0",
        "@types/nodemailer": "^6.4.14",
        "esbuild": "^0.27.2",
        "prisma": "^5.22.0",
        "tsx": "^4.6.2",
        "typescript": "^5.7.0"
    }
}